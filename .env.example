# Server-only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional AI tuning
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODEL=gpt-4.1-nano
# Number, or "none" to omit temperature for models that don't support it.
OPENAI_TEMPERATURE=0.2
AI_REQUESTS_PER_PLAYER_HOUR=120
AI_REQUESTS_GLOBAL_HOUR=5000
# Optional: replace the default system prompt (see src/server/ai/prompt.ts)
ZONKEY_SYSTEM_PROMPT=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase publishable (or legacy anon) key for email auth. Never use service_role here.
SUPABASE_PUBLISHABLE_KEY=

# Enable only after deploying the migration, configuring email delivery, and verifying test checkout.
ZONKEY_PLUS_ENABLED=false
ZONKEY_SITE_URL=https://zonkey.io
# Use sandbox/test keys in previews; live keys only in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
